# Copy this file to .env (same folder) and fill in real values. .env is gitignored.

# Port the API server listens on
PORT=3001

# Free key from https://console.groq.com  →  API Keys
GROQ_API_KEY=paste_your_groq_key_here

# Local databases (started via `npm run db:up` at repo root)
MONGO_URI=mongodb://localhost:27017/careerpilot
QDRANT_URL=http://localhost:6333
